# ——— Site ———————————————————————————————————————————————————————————————
# Canonical origin used for absolute URLs in metadata, the sitemap and
# structured data. Set to the production domain when deploying (no trailing
# slash). Vercel deployments fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ——— Sanity (production source of truth) ———————————————————————————————
# Everything in this section can be filled in automatically:
#   npx sanity login && npm run sanity:setup
# creates the project, dataset and both tokens, then writes .env.local.
# (The setup script authenticates via `sanity login`, or a personal token
# exported as SANITY_AUTH_TOKEN — that user token itself is never stored.)
#
# Project + dataset. With these set, the site fetches from the Content Lake;
# without them, development serves the local fixture content automatically.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# API version (YYYY-MM-DD). Defaults to 2025-08-01 when unset.
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-01

# Server-only. A "Viewer" token used for draft previews and live draft
# content. Never referenced from client components.
SANITY_API_READ_TOKEN=

# Server-only. An "Editor" token used exclusively by `npm run sanity:seed`.
SANITY_API_WRITE_TOKEN=

# Only needed to run `npm run sanity:setup` (project/dataset/token/CORS
# bootstrap via the Management API). A personal token from sanity.io/manage
# or a project robot token with management rights; never used by the site.
# SANITY_AUTH_TOKEN=

# Optional: the frontend origin the Studio Presentation tool previews
# (defaults to this app's own origin — set when Studio runs on another host).
SANITY_STUDIO_PREVIEW_URL=

# ——— Contact ————————————————————————————————————————————————————————————
# The Contact control renders only when a real address is configured — the
# fixtures intentionally ship none, and placeholder addresses (example.com)
# are neutralized so they can never appear in any build. In production this
# lives in Sanity site settings; on fixtures set it here:
# NEXT_PUBLIC_CONTACT_URL=mailto:you@yourdomain.com

# ——— Escape hatch ————————————————————————————————————————————————————————
# Production builds REQUIRE Sanity and fail with a configuration error
# otherwise. To intentionally build a production bundle from the local
# fixtures (CI, previews without a CMS), opt in explicitly:
# NEXT_PUBLIC_CONTENT_SOURCE=fixtures

# Content validation runs in "placeholder" mode on fixtures (placeholder
# URLs and addresses report as warnings) and "production" mode on Sanity
# (they become build errors). Force the strict mode early with:
# NEXT_PUBLIC_CONTENT_VALIDATION=production
